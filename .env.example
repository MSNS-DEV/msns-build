# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" and populate it with your secrets.

# When adding additional environment variables, the schema in "/src/env.js"
# should be updated accordingly.

# Prisma
# https://www.prisma.io/docs/reference/database-reference/connection-urls#env
DATABASE_URL="postgresql://postgres:password@localhost:5432/msns-auth"

# Auth.js
AUTH_SECRET=""
AUTH_URL="https://lms.msns.edu.pk"

# ── Two-factor authentication (see docs/two-factor-setup.md) ──
# Encrypts authenticator-app secrets. Generate with: openssl rand -base64 48
# Never change it once accounts have enrolled (their apps would stop working).
TWO_FACTOR_ENCRYPTION_KEY=""
# Signs "remember this device" cookies. Optional: falls back to AUTH_SECRET.
TRUSTED_DEVICE_SECRET=""

# SMS codes: smsgate (SMS Gateway for Android, default) | twilio | console (dev only)
SMS_PROVIDER="smsgate"
SMS_GATE_URL="https://api.sms-gate.app"
SMS_GATE_USERNAME=""
SMS_GATE_PASSWORD=""
# Stop sending SMS after this many per day (protects the SIM bundle).
SMS_DAILY_LIMIT="500"
# Only if SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM=""

# Email codes (optional)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="MSNS LMS <no-reply@msns.edu.pk>"

# Passkeys. Defaults come from AUTH_URL; set these only if they differ.
WEBAUTHN_RP_ID="lms.msns.edu.pk"
WEBAUTHN_ORIGIN="https://lms.msns.edu.pk"
